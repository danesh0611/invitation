<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>Kanakabhishekam Invitation – Thirukadaiyur</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500&family=Noto+Serif+Tamil:wght@500&family=Lato:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg1:#4a0d14; --bg2:#1a0508; --gold:#e3b858; --gold2:#f9e6a6; --cream:#fbeed0; --muted:#d9bfa0; --saffron:#f08a24; --line:rgba(227,184,88,.45);
  color-scheme:dark; box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
body{margin:0;color:var(--cream);font-family:'Lato',system-ui,sans-serif;line-height:1.7;text-align:center;overflow-x:hidden;
  background:radial-gradient(ellipse at 50% 0%,var(--bg1),var(--bg2) 70%) fixed, var(--bg2)}
body::before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.07;
  background-image:radial-gradient(var(--gold) 1px,transparent 1.5px);background-size:26px 26px}
.serif{font-family:'Cormorant Garamond',Georgia,serif}
.gold-text{background:linear-gradient(180deg,var(--gold2),var(--gold) 55%,#a8741f);-webkit-background-clip:text;background-clip:text;color:transparent}
#garland{display:block;width:100%;height:120px;position:relative;z-index:3}
.sway{transform-origin:top center;animation:sway 4s ease-in-out infinite alternate}
@keyframes sway{from{transform:rotate(-5deg)}to{transform:rotate(5deg)}}
.hero{position:relative;padding:8px 18px 0;margin-top:-30px;overflow:hidden}
.mandala{position:absolute;left:50%;top:34%;width:min(560px,120vw);transform:translate(-50%,-50%);opacity:.22;animation:spin 90s linear infinite;z-index:0}
@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}
.hero>*:not(.mandala){position:relative;z-index:1}
.tamil{font-family:'Noto Serif Tamil',serif;color:var(--gold);font-size:1.05rem;margin:24px 0 4px}
.eyebrow{letter-spacing:.35em;text-transform:uppercase;font-size:.72rem;color:var(--muted);margin:0}
.big90{font-family:'Cinzel Decorative',serif;font-size:clamp(6rem,30vw,10rem);line-height:1;margin:6px 0 0;filter:drop-shadow(0 0 22px rgba(240,170,60,.45))}
.big90 small{display:block;font-size:.2em;letter-spacing:.3em;margin-top:-6px}
h1{font-family:'Cinzel Decorative',serif;font-size:clamp(1.6rem,7.5vw,2.6rem);margin:14px 0 6px;line-height:1.2}
.of{font-style:italic;font-size:1.25rem;color:var(--muted);margin:14px 0 0}
.name{font-size:clamp(2.2rem,11vw,3.6rem);font-weight:700;margin:0;letter-spacing:.04em}
.date{display:inline-block;margin:22px 0 0;padding:10px 26px;border:1px solid var(--gold);border-radius:99px;color:var(--gold2);letter-spacing:.12em;font-size:.85rem;background:rgba(0,0,0,.25)}
.gop{position:relative;margin:26px auto 0;width:min(440px,94%)}
.gop img{position:relative;display:block;width:100%;height:auto;z-index:1;filter:drop-shadow(0 0 14px rgba(255,190,80,.55)) drop-shadow(0 10px 18px rgba(0,0,0,.6));animation:glowp 4s ease-in-out infinite alternate}
@keyframes glowp{to{filter:drop-shadow(0 0 28px rgba(255,205,100,.85)) drop-shadow(0 10px 18px rgba(0,0,0,.6))}}
.gop .glow{position:absolute;left:50%;top:48%;width:130%;aspect-ratio:1;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(240,170,60,.4),transparent 62%);z-index:0}
.base{position:relative;z-index:2;display:flex;align-items:center;gap:8px;margin-top:-2px}
.base i{flex:1;height:7px;border-radius:4px;background:linear-gradient(180deg,var(--gold2),#a8741f);box-shadow:0 0 12px rgba(227,184,88,.6)}
.diya{font-size:1.6rem;filter:drop-shadow(0 0 8px #ffb347);animation:flick 1.6s ease-in-out infinite alternate}
.diya:last-child{animation-delay:-.8s}
@keyframes flick{from{transform:scale(1)}to{transform:scale(1.15)}}
.gop figcaption{margin-top:12px;font-style:italic;font-size:1.1rem;color:var(--gold2)}
#gopuram{display:block;width:min(340px,80%);margin:28px auto 0;height:auto}
.wrap{max-width:660px;margin:0 auto;padding:0 18px}
.div{display:flex;align-items:center;gap:12px;color:var(--gold);margin:34px 0 22px;justify-content:center}
.div::before,.div::after{content:"";height:1px;flex:1;background:linear-gradient(90deg,transparent,var(--gold))}
.div::after{transform:scaleX(-1)}
h2{font-family:'Cinzel Decorative',serif;font-size:1.5rem;margin:0 0 14px}
.count{display:flex;gap:10px;justify-content:center;margin:10px 0 0}
.count div{width:74px;padding:12px 0;border:1px solid var(--line);border-radius:12px;background:rgba(0,0,0,.28)}
.count b{display:block;font-family:'Cinzel Decorative',serif;font-size:1.7rem;color:var(--gold2)}
.count span{font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}
.frame{position:relative;padding:22px;margin:14px 0;border:1px solid var(--gold);border-radius:6px;background:linear-gradient(160deg,rgba(255,255,255,.07),rgba(0,0,0,.25));text-align:left;box-shadow:0 0 0 5px rgba(0,0,0,.2),0 0 0 6px var(--line)}
.frame::before,.frame::after{content:"❖";position:absolute;color:var(--gold);background:var(--bg2);padding:0 6px;font-size:.9rem;top:-12px}
.frame::before{left:16px}.frame::after{right:16px}
.when{color:var(--saffron);font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:.78rem}
.frame h3{font-family:'Cormorant Garamond',serif;font-size:1.7rem;margin:2px 0 4px;color:var(--gold2)}
.frame p{margin:0;color:var(--muted)}
.tl{position:relative}
.tl::before{content:"";position:absolute;left:50%;top:-6px;bottom:-6px;width:1px;background:repeating-linear-gradient(var(--gold) 0 6px,transparent 6px 12px);opacity:.5;z-index:-1}
.btn{display:inline-block;margin-top:14px;padding:13px 28px;border-radius:99px;color:#3a0a0f;background:linear-gradient(180deg,var(--gold2),var(--gold));font-weight:700;text-decoration:none;box-shadow:0 6px 20px rgba(227,184,88,.3)}
.bless{font-size:1.35rem;font-style:italic;color:var(--gold2);margin:0}
footer{padding:20px 18px calc(36px + env(safe-area-inset-bottom,0px));color:var(--muted)}
footer .om{font-size:2.2rem;color:var(--gold)}
.petal{position:fixed;top:-30px;width:11px;height:16px;border-radius:70% 0 70% 0;pointer-events:none;z-index:2;opacity:.8;animation:fall linear infinite}
@keyframes fall{to{transform:translateY(110vh) rotate(540deg) translateX(40px)}}
.rv{opacity:0;transform:translateY(28px);transition:opacity .9s,transform .9s}
.rv.on{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.petal{display:none}.mandala,.sway{animation:none}.rv{opacity:1;transform:none;transition:none}}
</style>
</head>
<body>
<svg id="garland" aria-hidden="true"></svg>

<header class="hero">
  <svg class="mandala" id="mandala" viewBox="-100 -100 200 200" aria-hidden="true"></svg>
  <p class="tamil">ஓம் ஸ்ரீ அமிர்தகடேஸ்வரர் துணை</p>
  <p class="eyebrow">With the blessings of the Divine</p>
  <p class="big90 gold-text">90<small>YEARS</small></p>
  <h1 class="gold-text">Kanakabhishekam</h1>
  <p class="of serif">in honour of the 90th year of</p>
  <p class="name serif gold-text">K J Gopal</p>
  <span class="date">21 – 22 OCTOBER 2026 · THIRUKADAIYUR</span>
  <figure class="gop"><div class="glow"></div><img alt="Sri Amirthaghateswarar Temple gopuram, Thirukadaiyur" src="data:image/webp;base64,"><div class="base"><span class="diya">🪔</span><i></i><span class="diya">🪔</span></div><figcaption class="serif">Sri Amirthaghateswarar Temple, Thirukadaiyur</figcaption></figure>
</header>

<main class="wrap">
  <div class="div rv">✦ ❖ ✦</div>
  <section class="rv">
    <h2 class="gold-text">You Are Warmly Invited</h2>
    <p>With immense joy and gratitude to the Almighty, we invite you and your family to the Kanakabhishekam on the completion of the 90th year of Sri K J Gopal, at the sacred Thirukadaiyur temple. Your presence and blessings will make this occasion truly complete.</p>
  </section>

  <div class="div rv">✦ ❖ ✦</div>
  <section class="rv">
    <h2 class="gold-text">Programme</h2>
    <div class="tl">
      <div class="frame">
        <div class="when">Wednesday · 21 October · 5:00 PM</div>
        <h3>Go Pooja &amp; Gaja Pooja</h3>
        <p>Evening poojas to seek the blessings of the sacred cow and elephant.</p>
      </div>
      <div class="frame">
        <div class="when">Thursday · 22 October · 9:00 AM</div>
        <h3>Kanakabhishekam</h3>
        <p>The sacred golden abhishekam, followed by blessings and prasadam.</p>
      </div>
    </div>
  </section>

  <div class="div rv">✦ ❖ ✦</div>
  <section class="rv">
    <h2 class="gold-text">Venue</h2>
    <div class="frame" style="text-align:center">
      <h3>Sri Amirthaghateswarar Temple</h3>
      <p>Thirukadaiyur (Thirukkadaiyur)<br>Mayiladuthurai District, Tamil Nadu</p>
      <a class="btn" href="https://www.google.com/maps/search/?api=1&query=Amirthaghateswarar+Temple+Thirukkadaiyur" target="_blank" rel="noopener">Open in Maps</a>
    </div>
  </section>
</main>

<footer class="rv">
  <div class="div">✦ ❖ ✦</div>
  <p class="bless serif">“Your blessings are the greatest gift.”</p>
  <p>With love and respect</p>
  <div class="om">ॐ</div>
</footer>

<script>
(function(){
  var NS='http://www.w3.org/2000/svg';
  function el(t,a,p){var e=document.createElementNS(NS,t);for(var k in a)e.setAttribute(k,a[k]);if(p)p.appendChild(e);return e;}

  /* Garland with flowers and bells */
  function garland(){
    var s=document.getElementById('garland'),w=window.innerWidth,h=120,sag=70;
    s.innerHTML='';s.setAttribute('viewBox','0 0 '+w+' '+h);
    var n=Math.round(w/16),cols=['#f08a24','#f6b21b','#e9701a'];
    function pt(t){return [w*t,2*(1-t)*t*sag];}
    for(var i=0;i<=n;i++){
      var p=pt(i/n),g=el('g',{},s);
      el('circle',{cx:p[0],cy:p[1]+6,r:9,fill:cols[i%3]},g);
      el('circle',{cx:p[0],cy:p[1]+6,r:5,fill:cols[(i+1)%3],opacity:.9},g);
      el('circle',{cx:p[0],cy:p[1]+6,r:2,fill:'#7b1e1e'},g);
      if(i%3==0)el('ellipse',{cx:p[0]+8,cy:p[1]+14,rx:4,ry:7,fill:'#3f8a3a',transform:'rotate(40 '+(p[0]+8)+' '+(p[1]+14)+')'},g);
    }
    [0.2,0.5,0.8].forEach(function(t,k){
      var p=pt(t),g=el('g',{class:'sway',style:'transform-origin:'+p[0]+'px '+(p[1]+10)+'px;animation-delay:-'+k+'s'},s);
      el('line',{x1:p[0],y1:p[1]+10,x2:p[0],y2:p[1]+30,stroke:'#e3b858','stroke-width':1.5},g);
      el('path',{d:'M'+(p[0]-11)+' '+(p[1]+52)+' Q'+(p[0]-11)+' '+(p[1]+32)+' '+p[0]+' '+(p[1]+30)+' Q'+(p[0]+11)+' '+(p[1]+32)+' '+(p[0]+11)+' '+(p[1]+52)+' Z',fill:'#e3b858',stroke:'#a8741f'},g);
      el('circle',{cx:p[0],cy:p[1]+55,r:3.5,fill:'#f9e6a6'},g);
    });
  }
  garland();var rt;window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(garland,150);});

  /* Mandala */
  var m=document.getElementById('mandala');
  [95,80,50,22].forEach(function(r,i){el('circle',{r:r,fill:'none',stroke:'#e3b858','stroke-width':i%2?.6:1.2,'stroke-dasharray':i==1?'2 3':''},m);});
  for(var i=0;i<16;i++){
    el('ellipse',{cx:0,cy:-66,rx:7,ry:22,fill:'none',stroke:'#e3b858','stroke-width':.8,transform:'rotate('+(i*22.5)+')'},m);
    el('ellipse',{cx:0,cy:-36,rx:4,ry:12,fill:'#e3b858',opacity:.5,transform:'rotate('+(i*22.5+11)+')'},m);
  }

  /* Falling petals */
  var pc=['#f08a24','#f6b21b','#e9701a','#ffd36b'];
  if(!window.matchMedia('(prefers-reduced-motion:reduce)').matches){
    for(var k=0;k<16;k++){
      var d=document.createElement('div');d.className='petal';
      d.style.left=Math.random()*100+'vw';d.style.background=pc[k%4];
      d.style.animationDuration=(9+Math.random()*9)+'s';d.style.animationDelay='-'+(Math.random()*14)+'s';
      document.body.appendChild(d);
    }
  }

  /* Reveal */
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target);}});},{threshold:.12});
  document.querySelectorAll('.rv').forEach(function(e){io.observe(e);});

})();
</script>
</body>
</html>
